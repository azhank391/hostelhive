{
  "name": "hostel-management-system",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:fast": "next build",
    "build:prod": "cross-env NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 next build",
    "build:prod:fast": "cross-env NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 next build",
    "build:fastest": "cross-env NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 GENERATE_SOURCEMAP=false next build",
    "build:fastest:incremental": "cross-env NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 GENERATE_SOURCEMAP=false next build",
    "build:ultra": "cross-env NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 GENERATE_SOURCEMAP=false NEXT_SHARP=0 next build",
    "build:ultra:cache": "cross-env NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 GENERATE_SOURCEMAP=false NEXT_SHARP=0 next build",
    "build:analyze": "ANALYZE=true next build",
    "build:analyze:win": "set ANALYZE=true && next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "type-check": "tsc --noEmit",
    "type-check:build": "tsc --noEmit && next build",
    "test:build": "node scripts/build-performance.js",
    "compare:builds": "node scripts/compare-builds.js",
    "build:turbo": "turbo build:ultra",
    "build:turbo:fast": "turbo build:ultra --parallel"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.85.5",
    "@tanstack/react-query-devtools": "^5.85.5",
    "axios": "^1.11.0",
    "clsx": "^2.1.1",
    "file-saver": "^2.0.5",
    "html2canvas": "^1.4.1",
    "jspdf": "^3.0.1",
    "lucide-react": "^0.540.0",
    "next": "^15.4.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.62.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/file-saver": "^2.0.7",
    "@types/node": "^24.2.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "autoprefixer": "latest",
    "compression-webpack-plugin": "^11.1.0",
    "critters": "^0.0.23",
    "eslint": "^8.50.0",
    "eslint-config-next": "^14.0.0",
    "postcss": "latest",
    "tailwindcss": "3.4.17",
    "typescript": "^5.5.4"
  }
}
